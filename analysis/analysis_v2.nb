Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"**", " ", "Estimating"}], " ", "Unconditional", " ", "Mutual", 
    " ", "Information"}], " ", "***)"}], 
  RowBox[{"(*", " ", 
   RowBox[{"Curr", " ", "Position", " ", "div", " ", "by", " ", "HofC"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"DateString", "[", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Comp", "=", "\"\<N1\>\""}], ";", 
    RowBox[{"Agent", "=", "\"\<R\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MINorm", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"start", " ", "=", " ", "401"}], ";", " ", 
    RowBox[{"end", " ", "=", " ", "1360"}], ";", 
    RowBox[{"step", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"time", "=", "start"}], ",", 
      RowBox[{"time", "\[LessEqual]", "end"}], ",", 
      RowBox[{"time", "=", 
       RowBox[{"time", "+", "step"}]}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"Print", "[", "time", "]"}], ";", "\[IndentingNewLine]", "\t", 
       
       RowBox[{"CompVar", "=", 
        RowBox[{"{", "}"}]}], ";", 
       RowBox[{"CurrPosVar", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"rec", "=", "1"}], ",", 
         RowBox[{"rec", "\[LessEqual]", "NumRecordings"}], ",", 
         RowBox[{"rec", "++"}], ",", "\[IndentingNewLine]", "\t\t", 
         RowBox[{
          RowBox[{"TrialData", "=", 
           RowBox[{"RecordingFiles", "[", 
            RowBox[{"[", "rec", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\t\t", 
          RowBox[{"TimedRow", "=", 
           RowBox[{"TrialData", "[", 
            RowBox[{"[", "time", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\t\t", 
          RowBox[{"CompPos", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"Components", ",", "Comp"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\t\t", 
          RowBox[{"If", " ", "[", 
           RowBox[{
            RowBox[{"Agent", "\[Equal]", "\"\<R\>\""}], ",", 
            "\[IndentingNewLine]", "\t\t\t", 
            RowBox[{"offset", "=", "AgentRecordingLength"}], ",", 
            "\[IndentingNewLine]", "\t\t\t", 
            RowBox[{"offset", "=", "0"}]}], "]"}], ";", "\[IndentingNewLine]",
           "\t\t", 
          RowBox[{"CompValue", "=", 
           RowBox[{"TimedRow", "[", 
            RowBox[{"[", 
             RowBox[{"offset", "+", "CompPos"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"Xind", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"Components", ",", "\"\<X\>\""}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\t\t", 
          RowBox[{"CurrPos", "=", 
           RowBox[{"TimedRow", "[", 
            RowBox[{"[", 
             RowBox[{"offset", "+", "Xind"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"CurrPosVar", "=", 
           RowBox[{"Append", "[", 
            RowBox[{"CurrPosVar", ",", "CurrPos"}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "\t", "]"}], ";", "\[IndentingNewLine]", "\t", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"CurrPosVals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"i", ",", 
          RowBox[{"{", 
           RowBox[{
           "i", ",", "minCurrPos", ",", "maxCurrPos", ",", "posBinSize"}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"compbins", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"i", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0.0", ",", 
            RowBox[{"1.0", "+", "compBinSize"}], ",", "compBinSize"}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"biVariates", "=", 
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{"CurrPosVar", ",", "CompVar"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"plot", ",", 
            RowBox[{"{", "bincounts", "}"}]}], "}"}], "=", 
          RowBox[{"Reap", "[", 
           RowBox[{"Histogram3D", "[", 
            RowBox[{"biVariates", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "targetbins", "}"}], ",", 
               RowBox[{"{", "compbins", "}"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"xbins", ",", "ybins", ",", "counts"}], "}"}], ",", 
               RowBox[{"Sow", "[", "counts", "]"}]}], "]"}]}], "]"}], "]"}]}],
          ";"}], "*)"}], "\[IndentingNewLine]", "\t", 
       RowBox[{"bincounts", "=", 
        RowBox[{"BinCounts", "[", 
         RowBox[{"biVariates", ",", 
          RowBox[{"{", 
           RowBox[{"minCurrPos", ",", 
            RowBox[{"maxCurrPos", "+", "posBinSize"}], ",", "posBinSize"}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.0", ",", 
            RowBox[{"1.0", "+", "compBinSize"}], ",", "compBinSize"}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"compvals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"i", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "1", ",", "compBinSize"}], "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"CurrPoscomps", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "CurrPosVals"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "compvals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"fCurrPoscomps", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"CurrPoscomps", ",", "1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"fbincounts", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"bincounts", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]",
        "\t", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"fbincounts", "=", 
          RowBox[{
           RowBox[{"fbincounts", "/", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"fbincounts", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{"Length", "[", "fbincounts", "]"}]}], "}"}]}], 
             "]"}]}], "//", "N"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       "\t", 
       RowBox[{"cofreqs", "=", 
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{"fCurrPoscomps", ",", "fbincounts"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"pCurrPosComp", "=", 
        RowBox[{"Interpolation", "[", 
         RowBox[{"cofreqs", ",", 
          RowBox[{"InterpolationOrder", "\[Rule]", "2"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"sumpCurrPosComp", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"pCurrPosComp", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", 
