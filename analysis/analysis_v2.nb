Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"**", " ", "Estimating"}], " ", "Unconditional", " ", "Mutual", 
    " ", "Information"}], " ", "***)"}], 
  RowBox[{"(*", " ", 
   RowBox[{"Target", " ", "Address", " ", "div", " ", "by", " ", "HofT"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"DateString", "[", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Comp", "=", "\"\<ML\>\""}], ";", 
    RowBox[{"Agent", "=", "\"\<R\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MINorm", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"start", " ", "=", " ", "401"}], ";", " ", 
    RowBox[{"end", " ", "=", " ", "1360"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"time", "=", "start"}], ",", 
      RowBox[{"time", "\[LessEqual]", "end"}], ",", 
      RowBox[{"time", "=", 
       RowBox[{"time", "+", "100"}]}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"Print", "[", "time", "]"}], ";", "\[IndentingNewLine]", "\t", 
       
       RowBox[{"TargetVar", "=", 
        RowBox[{"{", "}"}]}], ";", 
       RowBox[{"CompVar", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"rec", "=", "1"}], ",", 
         RowBox[{"rec", "\[LessEqual]", "NumRecordings"}], ",", 
         RowBox[{"rec", "++"}], ",", "\[IndentingNewLine]", "\t\t", 
         RowBox[{
          RowBox[{"TrialData", "=", 
           RowBox[{"RecordingFiles", "[", 
            RowBox[{"[", "rec", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\t\t", 
          RowBox[{"target", "=", 
           RowBox[{
            RowBox[{"TrialData", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\t\t", 
          RowBox[{"TargetVar", "=", 
           RowBox[{"Append", "[", 
            RowBox[{"TargetVar", ",", "target"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"TimedRow", "=", 
           RowBox[{"TrialData", "[", 
            RowBox[{"[", "time", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\t\t", 
          RowBox[{"CompPos", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"Components", ",", "Comp"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\t\t", 
          RowBox[{"If", " ", "[", 
           RowBox[{
            RowBox[{"Agent", "\[Equal]", "\"\<R\>\""}], ",", 
            "\[IndentingNewLine]", "\t\t\t", 
            RowBox[{"offset", "=", "AgentRecordingLength"}], ",", 
            "\[IndentingNewLine]", "\t\t\t", 
            RowBox[{"offset", "=", "0"}]}], "]"}], ";", "\[IndentingNewLine]",
           "\t\t", 
          RowBox[{"CompValue", "=", 
           RowBox[{"TimedRow", "[", 
            RowBox[{"[", 
