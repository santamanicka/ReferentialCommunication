         RowBox[{"TrialData", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"DistanceVar", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"DistanceVar", ",", "distance"}], "]"}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"targetbins", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "firstTarget", ",", 
         RowBox[{"lastTarget", "+", "targetBinSize"}], ",", "targetBinSize"}],
         "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"distancebins", "=", 
